# Token de Apify — https://console.apify.com/account/integrations
# El cliente lo busca en APIFY_TOKEN o en ~/.apify-cli/.env
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Opcional: correo de Google para publicar el documento vía MCP de Google Workspace
GOOGLE_EMAIL=tu@correo.com

# Opcional: carpeta permitida para import_to_google_doc
# ALLOWED_FILE_DIRS=~/.workspace-mcp/attachments
